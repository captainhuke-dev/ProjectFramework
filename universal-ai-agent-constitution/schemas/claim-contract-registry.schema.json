{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "registry_id",
    "contracts"
  ],
  "properties": {
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "token",
          "meaning",
          "issuer_scope",
          "substantiating_artifact",
          "validation_method",
          "admissible_evidence_classes",
          "freshness_or_expiry",
          "safe_fallback",
          "controls"
        ]
      }
    }
  },
  "additionalProperties": true
}
