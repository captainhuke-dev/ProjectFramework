{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version", "document_type", "receipt_id", "status", "project_id",
    "task_id", "boot_mode", "materiality", "project_binding_identity",
    "governance_identity", "project_law_identity", "state_authority_map_identity",
    "project_document_registry_identity", "capability_pack_identity",
    "skill_registry_identity", "adapter_registry_identity",
    "continuation_index_identity", "continuation_index_epoch", "freshness",
    "visibility", "pre_write_check", "applicable_procedures", "reading_scope",
    "observed_at", "observed_by"
  ],
  "properties": {
    "document_type": {"const": "UAAC_BOOT_RECEIPT"},
    "status": {"enum": ["PASS", "BLOCKED", "STALE", "NOT_RUN"]},
    "boot_mode": {"enum": ["FULL", "DELTA", "LIGHT"]},
    "materiality": {"enum": ["MATERIAL", "NON_MATERIAL", "UNKNOWN"]},
    "continuation_index_epoch": {"type": "integer", "minimum": 0},
    "freshness": {
      "type": "object",
      "required": ["reused_prior_scope", "prior_receipt_identity", "checked_identities", "invalidated_by"],
      "properties": {
        "reused_prior_scope": {"type": "boolean"},
        "checked_identities": {"type": "array"},
        "invalidated_by": {"type": "array"}
      }
    },
    "visibility": {
      "type": "object",
      "required": ["local_state", "canonical_surface", "receiver_visible", "observed_remote_identity", "unpublished_state_token"],
      "properties": {
        "local_state": {"enum": ["LOCAL_ONLY", "PENDING_CANONICAL_PUBLICATION", "CANONICAL_VISIBLE", "REMOTE_STALE"]},
        "receiver_visible": {"type": "boolean"},
        "unpublished_state_token": {"const": "PENDING_CANONICAL_PUBLICATION"}
      }
    },
    "pre_write_check": {
      "type": "object",
      "required": [
        "required", "status", "expected_governance_identity", "observed_governance_identity",
        "expected_project_law_identity", "observed_project_law_identity",
        "expected_continuation_index_identity", "observed_continuation_index_identity",
        "expected_artifact_base_identity", "observed_artifact_base_identity", "checked_at"
      ],
      "properties": {
        "required": {"type": "boolean"},
        "status": {"enum": ["PASS", "NOT_RUN", "STALE", "BLOCKED"]}
      }
    },
    "applicable_procedures": {"type": "array", "uniqueItems": true},
    "reading_scope": {"type": "array"}
  },
  "additionalProperties": true
}
