{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "document_type",
    "installation",
    "boot_receipt",
    "agent_adapter_registry",
    "project_binding",
    "constitution",
    "project",
    "governance_source",
    "constraint_register",
    "materiality",
    "authorized_channels",
    "state_authority_map",
    "current_continuation_index",
    "claim_contract_registry",
    "project_document_registry",
    "project_capability_pack",
    "conformance",
    "project_law",
    "project_wiki",
    "procedure_registry",
    "escalation_policy",
    "adopted_at",
    "adopted_by"
  ],
  "properties": {
    "document_type": {
      "const": "CONSTITUTION_ADOPTION"
    },
    "installation": {
      "type": "object",
      "required": [
        "protocol_id",
        "lifecycle_state",
        "validation_locator",
        "effective_authority_ref"
      ],
      "properties": {
        "lifecycle_state": {
          "enum": [
            "REQUESTED",
            "DISCOVERED",
            "PLANNED",
            "STAGED",
            "CORE_INSTALLED",
            "PROJECT_PROFILE_RESOLVED",
            "PROJECT_DOCUMENTS_RESOLVED",
            "SKILLS_MATERIALIZED",
            "AGENT_ENTRYPOINTS_CONFIGURED",
            "INSTALLATION_VALIDATED",
            "EFFECTIVE",
            "BLOCKED"
          ]
        }
      }
    },
    "constitution": {
      "type": "object",
      "required": [
        "id",
        "version",
        "upstream_source",
        "upstream_observed_commit",
        "local_locator",
        "pinned_reference"
      ]
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "boundary"
      ]
    },
    "governance_source": {
      "type": "object",
      "required": [
        "repository",
        "canonical_ref_policy",
        "bootstrap_path",
        "bootstrap_canonical_url"
      ]
    }
  },
  "additionalProperties": true
}
