{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "document_type",
    "registry_id",
    "project_id",
    "documents",
    "conflicts",
    "last_verified_at",
    "last_verified_by"
  ],
  "properties": {
    "document_type": {
      "const": "PROJECT_DOCUMENT_REGISTRY"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "status",
          "locator",
          "identity",
          "state_class"
        ],
        "properties": {
          "status": {
            "enum": [
              "RESOLVED",
              "NOT_APPLICABLE",
              "BLOCKED",
              "STALE",
              "CONFLICTED"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": true
}
