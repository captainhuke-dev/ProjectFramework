{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "document_type",
    "validation_id",
    "project_id",
    "status",
    "installation_protocol",
    "constitution_identity",
    "front_door",
    "static_checks",
    "cross_agent_convergence",
    "behavioral_scenarios",
    "known_limitations",
    "validated_at",
    "validated_by",
    "effective_adoption"
  ],
  "properties": {
    "document_type": {
      "const": "UAAC_INSTALLATION_VALIDATION"
    },
    "status": {
      "enum": [
        "INSTALLATION_VALIDATED",
        "INSTALLATION_UNVERIFIED",
        "INSTALLATION_BLOCKED"
      ]
    },
    "cross_agent_convergence": {
      "type": "object",
      "required": [
        "status",
        "resolutions"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN"
          ]
        },
        "resolutions": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": [
              "agent_id",
              "entrypoint",
              "project_id",
              "constitution_identity",
              "project_law_identity",
              "state_authority_map_identity",
              "continuation_index_identity",
              "project_document_registry_identity",
              "skill_registry_identity",
              "adapter_registry_identity",
              "canonical_access"
            ],
            "properties": {
              "canonical_access": {
                "type": "object",
                "required": [
                  "status",
                  "locator",
                  "observed_identity",
                  "observed_at"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "PASS",
                      "FAIL",
                      "NOT_RUN"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
