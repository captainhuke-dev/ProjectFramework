{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "map_id",
    "version",
    "state_classes",
    "derived_context",
    "conflict_policy"
  ],
  "properties": {
    "state_classes": {
      "type": "object",
      "required": [
        "GOVERNANCE",
        "SOURCE_ARTIFACTS",
        "RUNTIME_JOBS",
        "EVIDENCE",
        "CONTINUATION",
        "EXTERNAL_EFFECTS"
      ],
      "additionalProperties": false,
      "patternProperties": {
        ".*": {
          "type": "object",
          "required": [
            "canonical",
            "derived_replicas"
          ],
          "properties": {
            "canonical": {
              "type": "object",
              "required": [
                "locator",
                "identity",
                "write_authority_ref"
              ]
            },
            "derived_replicas": {
              "type": "array"
            }
          }
        }
      }
    },
    "derived_context": {
      "type": "object",
      "required": [
        "authority_effect",
        "canonical_truth_effect",
        "locators"
      ]
    }
  },
  "additionalProperties": true
}
