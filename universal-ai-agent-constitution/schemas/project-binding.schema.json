{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version", "document_type", "status", "project_id", "project_root",
    "canonical_repository", "canonical_ref_policy", "governance_front_door",
    "nested_project_policy", "observed_local_binding"
  ],
  "properties": {
    "document_type": {"const": "PROJECT_BINDING"},
    "status": {"enum": ["VERIFIED", "BLOCKED", "STALE", "CONFLICTED"]},
    "project_root": {"type": "string", "minLength": 1},
    "canonical_repository": {"type": "string", "minLength": 1},
    "canonical_ref_policy": {"type": "string", "minLength": 1},
    "governance_front_door": {"const": "governance/UAAC-BOOT.md"},
    "nested_project_policy": {"enum": ["EXCLUDE_DECLARED_NESTED_PROJECTS", "NO_NESTED_PROJECTS"]},
    "observed_local_binding": {
      "type": "object",
      "required": ["root_identity", "repository_identity", "observed_at", "observed_by"]
    }
  },
  "additionalProperties": true
}
