{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "procedures"
  ],
  "properties": {
    "procedures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "procedure_id",
          "function",
          "status",
          "triggers",
          "entrypoint",
          "source_laws",
          "project_law_identity",
          "authority_effect",
          "volatile_truth_embedded",
          "adapter_registry_identity",
          "invocation_contract"
        ],
        "properties": {
          "invocation_contract": {
            "type": "object",
            "required": [
              "trigger",
              "automatic_by_applicability",
              "user_restatement_required"
            ],
            "properties": {
              "trigger": {
                "enum": [
                  "EVERY_MATERIAL_TASK",
                  "EVENT_DRIVEN",
                  "EXPLICIT_ONLY"
                ]
              },
              "automatic_by_applicability": {
                "type": "boolean"
              },
              "user_restatement_required": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
