{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/uaac/5.0/uaac-adoption.schema.json",
  "title": "UAAC 5.0 minimal adoption",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "constitution"],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "boundary"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "boundary": {"type": "string", "minLength": 1}
      }
    },
    "constitution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "local_locator", "immutable_identity"],
      "properties": {
        "id": {"const": "UAAC-001"},
        "version": {"const": "5.0.0"},
        "local_locator": {"type": "string", "minLength": 1},
        "immutable_identity": {"type": "string", "minLength": 1}
      }
    },
    "project_rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/locator"}
    },
    "canonical_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "locator"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1}
        }
      }
    },
    "continuation": {"$ref": "#/$defs/locator"},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "locator"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator"],
      "properties": {
        "locator": {"type": "string", "minLength": 1}
      }
    }
  }
}
